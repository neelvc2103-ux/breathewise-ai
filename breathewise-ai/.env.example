# Mandatory in production; AI Studio injects GEMINI_API_KEY automatically via Settings > Secrets
GEMINI_API_KEY=

# Google Maps Platform browser API key (injected via AI Studio Maps setup or environment)
VITE_GOOGLE_MAPS_API_KEY=

# Application URL (automatically injected in AI Studio preview)
APP_URL=http://localhost:3000

# Security & Session Signing (falls back to secure ephemeral random key in dev if unset)
AUTH_SECRET=

# Database connection (SQLite local file used automatically in preview; PostgreSQL URL for Docker/Cloud deployment)
SQLITE_PATH=./data/breathewise.db
DATABASE_URL=

# AI Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-4-hydrogen
AI_DAILY_USER_LIMIT=40

# External Environmental APIs (Open-Meteo defaults require no paid subscription)
AIR_QUALITY_API_BASE=https://air-quality-api.open-meteo.com/v1
WEATHER_API_BASE=https://api.open-meteo.com/v1
GEOCODING_API_BASE=https://geocoding-api.open-meteo.com/v1
# Optional free secondary air quality fallback when Open-Meteo is rate-limited (HTTP 429) on shared IPs
OPENWEATHER_API_KEY=

# Optional Email Delivery (logs verification/reset links securely in dev when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@breathewise.local

# Demo Mode (enables evaluator scenarios and demo accounts in non-production or explicit evaluation)
DEMO_MODE=true
