// Production PostgreSQL Prisma schema mirroring the normalized SQLite runtime schema.
// Use this schema when deploying with PostgreSQL / Cloud SQL / Docker Compose.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INDIVIDUAL_USER
  FAMILY_ADMIN
  FAMILY_MEMBER
  COMMUNITY_MODERATOR
  SYSTEM_ADMIN
}

enum AqiStandard {
  US_EPA
  INDIA_NAQI
}

model User {
  id                  String   @id @default(uuid())
  fullName            String
  email               String   @unique
  passwordHash        String
  role                UserRole @default(INDIVIDUAL_USER)
  emailVerified       Boolean  @default(false)
  onboardingCompleted Boolean  @default(false)
  acceptedTermsAt     DateTime
  isDemo              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  profile             UserProfile?
  sessions            Session[]
  activityLogs        ActivityLog[]
  conversations       AIConversation[]
  dailyRoutines       DailyRoutine[]
  householdMembers    HouseholdMember[]
  notifications       Notification[]
  notificationPref    NotificationPreference?
  communityPosts      CommunityPost[]
  userAchievements    UserAchievement[]
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String    @default("")
  ipAddress  String    @default("")
  rememberMe Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserProfile {
  userId                    String      @id
  country                   String      @default("India")
  stateRegion               String      @default("Delhi NCR")
  city                      String      @default("New Delhi")
  postalCode                String?
  latitude                  Float       @default(28.6139)
  longitude                 Float       @default(77.2090)
  aqiStandard               AqiStandard @default(INDIA_NAQI)
  workMode                  String      @default("office")
  commuteDistanceKm         Float       @default(12)
  primaryTransport          String      @default("car_petrol")
  cookingFuel               String      @default("lpg_piped_gas")
  householdSize             Int         @default(3)
  publicTransitAvailable    Boolean     @default(true)
  childrenCount             Int         @default(0)
  adultsCount               Int         @default(2)
  elderlyCount              Int         @default(0)
  hasSensitiveMembers       Boolean     @default(false)
  hasAirPurifier            Boolean     @default(false)
  ventilationType           String      @default("natural_windows")
  indoorCookingVentilation  String      @default("exhaust_fan")
  hasIndoorSensor           Boolean     @default(false)
  preferredLanguage         String      @default("en")
  sustainabilityGoal        String      @default("")
  budgetLevel               String      @default("low_cost")
  consentWithdrawn          Boolean     @default(false)
  updatedAt                 DateTime    @updatedAt
  user                      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Household {
  id              String                @id @default(uuid())
  name            String
  city            String
  sharedGoal      String
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  members         HouseholdMember[]
  invitations     HouseholdInvitation[]
  activityLogs    ActivityLog[]
}

model HouseholdMember {
  id            String    @id @default(uuid())
  householdId   String
  userId        String
  householdRole UserRole
  joinedAt      DateTime  @default(now())
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
}

model HouseholdInvitation {
  id           String    @id @default(uuid())
  householdId  String
  invitedEmail String
  role         UserRole
  tokenHash    String    @unique
  status       String    @default("PENDING")
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String
  city      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  sender         String
  contentText    String
  structuredJson Json?
  providerUsed   String?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model DailyRoutine {
  id              String            @id @default(uuid())
  userId          String
  dateIso         String
  city            String
  aqiAtGeneration Int
  aqiStandard     AqiStandard
  providerUsed    String
  summary         String
  createdAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities      RoutineActivity[]

  @@index([userId, dateIso])
}

model RoutineActivity {
  id                   String       @id @default(uuid())
  routineId            String
  category             String
  title                String
  scheduledTime        String
  suggestedAlternative String
  exposureNote         String
  environmentalNote    String
  reason               String
  isIndoor             Boolean      @default(false)
  completed            Boolean      @default(false)
  routine              DailyRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model EmissionFactor {
  id                       String        @id @default(uuid())
  code                     String        @unique
  category                 String
  label                    String
  unit                     String
  baselineKgCo2ePerUnit    Float
  alternativeKgCo2ePerUnit Float
  fuelLitersPerUnit        Float         @default(0)
  source                   String
  region                   String
  publicationYear          Int
  assumptions              String
  activities               ActivityLog[]
}

model ActivityLog {
  id                String         @id @default(uuid())
  userId            String
  householdId       String?
  factorCode        String
  activityTitle     String
  quantity          Float
  unit              String
  co2eAvoidedKg     Float
  fuelSavedLiters   Float          @default(0)
  vehicleKmAvoided  Float          @default(0)
  energySavedKwh    Float          @default(0)
  dedupKey          String
  notes             String         @default("")
  activityDate      String
  createdAt         DateTime       @default(now())
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  household         Household?     @relation(fields: [householdId], references: [id], onDelete: SetNull)
  factor            EmissionFactor @relation(fields: [factorCode], references: [code])

  @@unique([userId, dedupKey])
  @@index([userId, activityDate])
}

model Community {
  id          String          @id @default(uuid())
  city        String          @unique
  region      String
  country     String
  description String
  posts       CommunityPost[]
}

model CommunityPost {
  id          String            @id @default(uuid())
  communityId String
  city        String
  userId      String
  authorName  String
  title       String
  content     String
  category    String
  isVerified  Boolean           @default(false)
  isRemoved   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  community   Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     CommunityReport[]
}

model CommunityReport {
  id               String        @id @default(uuid())
  postId           String
  reportedByUserId String
  reason           String
  status           String        @default("PENDING")
  reviewedByUserId String?
  createdAt        DateTime      @default(now())
  post             CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Achievement {
  id                String            @id @default(uuid())
  code              String            @unique
  title             String
  description       String
  criteriaMetric    String
  criteriaThreshold Float
  users             UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  severity  String
  dedupKey  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NotificationPreference {
  userId              String   @id
  aqiThreshold        Int      @default(150)
  quietHoursStart     String   @default("22:00")
  quietHoursEnd       String   @default("06:30")
  timezone            String   @default("Asia/Kolkata")
  inAppEnabled        Boolean  @default(true)
  emailEnabled        Boolean  @default(false)
  browserEnabled      Boolean  @default(false)
  weeklyReportEnabled Boolean  @default(true)
  unsubscribedAll     Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EducationalResource {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  category           String
  summary            String
  content            String
  sourceOrganization String
  sourceUrl          String
  readingMinutes     Int      @default(4)
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  details     String
  ipAddress   String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
